# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------
# OpenRouter API key. Create one at https://openrouter.ai/keys
# Used for both chat completions and text embeddings.
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------
# Chat model used for contextual retrieval and query transformation.
# Must be a valid OpenRouter model id: https://openrouter.ai/models
# The notebook sets this itself; override only to use a different model.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Qdrant endpoint. Defaults to a local instance if unset.
QDRANT_URL=http://localhost:6333
